# Secrets da Edge Function capture-lead. NUNCA commitar valores reais.
# Definir via: supabase secrets set --env-file supabase/functions/.env (manual, por voce).

# Injetados pelo Supabase em runtime, nao precisa setar manualmente no deploy:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Provedor de email
RESEND_API_KEY=
RESEND_FROM=Jogo 90 Dias <no-reply@cosmosec.com.br>

# CORS: origem do front. Em dev http://localhost:5173, em prod o dominio do jogo.
ALLOWED_ORIGIN=http://localhost:5173

# Cloudflare Turnstile (opcional). Sem isto, a verificacao fica desligada.
TURNSTILE_SECRET=
