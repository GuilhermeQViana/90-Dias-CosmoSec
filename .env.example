# Config do cliente (Vite). Copie para .env.local e preencha.
# Sem estas variaveis, a captura de lead usa o mock e o jogo funciona normal.

# URL base do projeto Supabase e a anon key (publica, pode ir ao cliente).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Liga a chamada real da Edge Function. Sem isto, fica no mock.
VITE_CAPTURE_LEAD=mock
